{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "strict": false,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@cata-raid-sim/engine": [
        "./DEV/packages/engine/src/index.ts"
      ],
      "@cata-raid-sim/engine/*": [
        "./DEV/packages/engine/src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "DEV/packages/engine/src/**/*",
    "DEV/packages/web/src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "QA",
    "DEV/packages/*/dist"
  ]
}
